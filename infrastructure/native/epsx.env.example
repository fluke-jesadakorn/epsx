PORT=9180
# DATABASE_URL=... (existing production database for this service)
# ANALYTICS_DATABASE_URL=...
# PAYMENTS_DATABASE_URL=...
# NOTIFICATIONS_DATABASE_URL=...
# RSA_PRIVATE_KEY_FILE=/etc/epsx/keys/signing.pem
# RSA_PUBLIC_KEY_FILE=/etc/epsx/keys/signing.pub.pem
# RSA_KEY_ID=... (preserve the existing key ID)
# JWT_SECRET=... (preserve existing value)
# REFRESH_TOKEN_HMAC_ACTIVE_KID=... (preserve existing keyring)
# REFRESH_TOKEN_HMAC_KEYS_JSON='{"existing-kid":"existing-base64-key"}'
# REDIS_URL=redis://:EXISTING_PASSWORD@127.0.0.1:6379
# MINIO_ENDPOINT=http://127.0.0.1:9100
# MINIO_ACCESS_KEY=...
# MINIO_SECRET_KEY=...
# MINIO_PUBLIC_URL=... (existing HTTPS object URL)
# BSC_RPC_URL=... (existing package-payment chain RPC)
# PAYMENT_ESCROW_ADDRESS=... (existing package-payment contract, unchanged)
# EPSX is a normal Pay merchant. Store its server key only in this backend file.
# EPSX_PAY_API_KEY=epsxpay_live_...
# EPSX_PAY_MERCHANT_ID=mer_...
# EPSX_PAY_ENVIRONMENT=live
# EPSX_PAY_RECIPIENT=... (EPSX merchant's registered wallet)
# EPSX_PAY_WEBHOOK_SECRET_OUTBOUND=whsec_... (outgoing merchant endpoint secret)
