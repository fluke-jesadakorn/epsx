PORT=38103
# DATABASE_URL=... (existing production database for this service)
# PAY_ESCROW_V1_CONTRACT=... (new reviewed deployment only)
# PAY_ESCROW_ADMIN=... (existing Admin wallet)
# PAY_ESCROW_TREASURY=... (reviewed fee recipient; defaults to Admin)
# PAY_ESCROW_DEPLOYMENT_BLOCK=...
# PAY_ESCROW_RPC_URL=https://...
# CHAIN_ID=56
# PAY_ESCROW_CONFIRMATIONS=15
# PAY_ESCROW_TOKENS='{"BNB":{"address":"0x0000000000000000000000000000000000000000","decimals":18}}'
# Add reviewed USDT/USDC addresses and decimals matching the deployed allowlist.
# EPSX_PAY_WEBHOOK_SECRET=... (at least 32 bytes)
# Merchant platform is additive. Keep all legacy values above unchanged.
# PAY_MERCHANT_SECRET=... (persistent random secret, at least 32 bytes; back up with keys)
# PAY_MERCHANT_NETWORKS=... (JSON array; see docs/pay/operations.md)
# PAY_EPSX_MERCHANT_ID=mer_... (must match backend EPSX_PAY_MERCHANT_ID for plan snapshots)
# PAY_ESCROW_ARCHIVE_RPC_URL=... (optional; used only for pruned log history)
# PAY_ESCROW_SCAN_BLOCKS=10 (1..50; increase only after provider qualification)
# Merchant network JSON accepts archive_rpc_url and scan_blocks with the same policy.
