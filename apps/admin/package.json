{
  "name": "@epsx/admin-css",
  "version": "0.0.1",
  "private": true,
  "description": "EPSX admin (Dioxus BFF) CSS pipeline — Tailwind v4 + PostCSS local build",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./public/dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/index.css -o ./public/dist/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "autoprefixer": "10.4.22",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20"
  }
}
