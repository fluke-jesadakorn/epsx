# Environment Files
.env
.env.*
!.env.example
!.env.development
!.env.staging
!.env.production
!.env.template
!.env.*.template
!.env.*.enc
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!**/.env.*.template
!**/.env.*.enc
production.env
development.env

# Logs
logs/
*.log

# OS Files
.DS_Store
Thumbs.db
*~

# IDE
.vscode/
.idea/
*.swp
*.swo

# Rust
target/
target-check/
**/*.rs.bk
