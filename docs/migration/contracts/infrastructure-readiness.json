    { "id": "I06", "category": "service-exposure", "severity": "stop", "status": "blocked", "summary": "Raw backend, analytics and pay service workloads are exposed through NodePorts without an internal-only policy proof.", "evidenceIds": ["prod-nodeports", "prod-pay-nodeports"], "resolution": "Expose only intended edge/BFF surfaces and enforce NetworkPolicy or an equivalent direct-service boundary." },
    { "id": "I07", "category": "nodeport-collision", "severity": "stop", "status": "blocked", "summary": "Prod pay NodePorts 30082/30083 are also assigned by the staging overlay and bridge comments identify them as staging.", "evidenceIds": ["prod-pay-nodeports", "pay-host-bridge"], "resolution": "Allocate environment-unique cluster-global NodePorts and lock the bridge map." },
