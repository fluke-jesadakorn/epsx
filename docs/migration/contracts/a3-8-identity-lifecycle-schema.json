  "lifecycleDesign": {
    "identity": "Application-generated UUID subjects map one-to-one to lowercase EVM wallet addresses; permission, plan, role, and subscription authority is intentionally absent.",
    "siweChallenge": "Issuance must store the exact requested frontend or admin client with the challenge; verification and atomic consume must match that stored client, and token issuance must use only the returned stored client.",
    "crossClientReplay": "A challenge issued for one client must fail verification, consume, and token issuance when presented for the other client, even when wallet, chain, domain, nonce digest, and message digest otherwise match.",
    "refreshRotation": "Runtime must conditionally consume one active unexpired digest and insert one child in the same transaction; declarative family and parent keys preserve user, family, and client lineage, but exact child generation equals parent generation plus one remains a transactional concurrency STOP.",
    "refreshRevocationRace": "Refresh rotation and family revocation must share one atomic row-locking or serializable boundary: rotation must lock the family row, require revoked_at IS NULL, and let concurrent revocation win by failing rotation before parent consume or child insert.",
    "refreshStorage": "Only a keyed 32-byte token digest and non-secret key identifier/version are stored; the schema does not claim or enforce a particular digest algorithm, and raw refresh tokens and signing secrets never enter this schema.",
    "runtimeImplemented": false,
    "concurrencyProven": false,
    "crossClientReplayProven": false,
    "exactGenerationIncrementProven": false,
    "revokeVsRotateProven": false
  },
